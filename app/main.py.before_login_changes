        db.close()

        raise HTTPException(
            status_code=403,
            detail="Phone number is not verified"
        )

    user.display_name = request.display_name

    db.commit()
    db.refresh(user)

    db.close()

    return {
        "message": "Profile created successfully",
        "user_id": user.id,
        "phone_number": user.phone_number,
        "display_name": user.display_name
    }


